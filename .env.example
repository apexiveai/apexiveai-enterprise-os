APP_NAME=ApexiveAI Enterprise OS
APP_VERSION=1.0.0
APP_ENV=development
AUTO_CREATE_TABLES=false

# Bootstrap replaces this placeholder with a random local-only password.
POSTGRES_PASSWORD=generate-locally-with-scripts-bootstrap-local.ps1
DATABASE_URL=postgresql+psycopg://max:replace-with-bootstrap-password@localhost:5432/max_enterprise
REDIS_URL=redis://127.0.0.1:6379/0

# Workspace identifier only; this is not an authentication boundary.
VITE_TENANT_ID=local-workspace
VITE_APP_URL=https://international-construction-software.vercel.app

# Leave blank for same-origin deployments. Set this to the backend origin for cross-origin deployments.
VITE_API_URL=

# Optional OpenAI-compatible provider. Leave blank until configured.
OPENAI_BASE_URL=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
